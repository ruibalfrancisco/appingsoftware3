# Copiá este archivo a .env (que nunca se sube) y completá lo que falte.
# Los valores de ejemplo son los de infra/docker-compose.yml y solo sirven en tu máquina.
# En staging y producción las variables se cargan en Railway; en el pipeline, en GitHub.

# ---------- api (backend/) ----------
DATABASE_URL=postgresql://reclamos:reclamos@localhost:5432/reclamos
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Generalo con: openssl rand -hex 32 (distinto en cada ambiente)
JWT_SECRET=

# Fotos: S3 compatible (RustFS en local, Railway Bucket en staging y producción)
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=reclamos
AWS_SECRET_ACCESS_KEY=reclamos-local
AWS_S3_BUCKET_NAME=fotos
AWS_DEFAULT_REGION=us-east-1

# Email: smtp (Mailpit) en local y CI, resend en Railway
EMAIL_BACKEND=smtp
EMAIL_FROM=no-responder@reclamos.local
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# ---------- web (frontend/) ----------
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
