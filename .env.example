# Copiá este archivo a .env (que nunca se sube) y completá lo que falte.
# Los valores de ejemplo son los de infra/docker-compose.yml y solo sirven en tu máquina.
# Se usa 127.0.0.1 y no localhost: en Windows, localhost prueba primero IPv6 (::1) y cada
# conexión a Docker puede tardar varios segundos antes de caer en IPv4.
# En staging y producción las variables se cargan en Railway; en el pipeline, en GitHub.

# ---------- api (backend/) ----------
DATABASE_URL=postgresql://reclamos:reclamos@127.0.0.1:5432/reclamos
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Generalo con: openssl rand -hex 32 (distinto en cada ambiente)
JWT_SECRET=

# Fotos: S3 compatible (RustFS en local, Railway Bucket en staging y producción)
AWS_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=reclamos
AWS_SECRET_ACCESS_KEY=reclamos-local
AWS_S3_BUCKET_NAME=fotos
AWS_DEFAULT_REGION=us-east-1
# path para RustFS; en Railway (bucket nuevo) es virtual.
AWS_S3_ADDRESSING_STYLE=path

# Email: smtp (Mailpit) en local y CI, resend en Railway
EMAIL_BACKEND=smtp
EMAIL_FROM=no-responder@reclamos.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
RESEND_API_KEY=

# ---------- web (frontend/) ----------
# La web llama a la API en /api (proxy de Vite en local, nginx en Railway).
# Solo si la API local no está en http://localhost:8000:
# API_INTERNAL_URL=http://localhost:8000
# Mapa: OpenStreetMap, sin key. Con VITE_MAPA=simulado se usa el mapa sin red de las pruebas.
# VITE_MAPA=simulado
# Dirección del pin con Nominatim (OpenStreetMap); false para no depender de internet.
# GEOCODIFICAR=false
